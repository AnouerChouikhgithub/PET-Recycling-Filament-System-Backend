# =============================================================================
# 3awedlou backend — copy to .env.local (NEVER commit .env.local) and fill in.
#   cp .env.example .env.local
# Values below are PLACEHOLDERS. Real secrets live only in .env.local or the
# process environment — never in git.
# =============================================================================

# --- Symfony core -----------------------------------------------------------
# dev | prod | test
APP_ENV=dev
# `php bin/console secret:generate` or: openssl rand -base64 32
APP_SECRET=CHANGE_ME_generate_with_bin_console_secret_generate
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# --- Database (PostgreSQL 17 via `docker compose up -d`) --------------------
# serverVersion must match your server; charset utf8.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/db_3awedlou?serverVersion=17&charset=utf8"

# --- JWT (RS256) ------------------------------------------------------------
# Generate once with:  php bin/console lexik:jwt:generate-keypair
# (writes config/jwt/private.pem + public.pem — git-ignored)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase you chose when generating the keypair (may be empty in dev)
JWT_PASSPHRASE=

# --- CORS -------------------------------------------------------------------
# Regex of allowed browser origins. Dev default covers Vite (5173) + Expo web.
# PRODUCTION: pin to your real origin, e.g. ^https://app\.3awedlou\.example$
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$

# --- Auth policy ------------------------------------------------------------
# Set to false to close open registration (login keeps working).
AUTH_REGISTER_ENABLED=true

# --- Machine domain ---------------------------------------------------------
# A machine is OFFLINE when its last report is older than this many minutes.
MACHINE_OFFLINE_AFTER_MINUTES=10

# Command safety limits (backend-side guard; firmware PET PID target is 245 °C,
# so the heater cap must stay above 245 but far below danger).
COMMAND_HEATER_MAX_C=260
COMMAND_MOTOR_MAX=100
COMMAND_FAN_MAX=100

# --- MQTT (phase 3: a real broker client, OFF by default) -------------------
# Broker CREDENTIALS (MQTT_USERNAME / MQTT_PASSWORD) never live here and never
# live in .env — they go in .env.local or the process environment only.
#
# With MQTT_ENABLED=false (the default) MqttPublisherInterface resolves to the
# in-memory buffering publisher: no socket, no broker, and dev/tests behave
# exactly as before. Set MQTT_ENABLED=true only when the broker is running
# (`docker compose -f compose.mqtt.yaml up -d`).
MQTT_ENABLED=false
MQTT_HOST=localhost
MQTT_PORT=1883
# Broker user created with bin/mqtt-user.ps1 / bin/mqtt-user.sh.
# The backend user is `backend`; a DEVICE must use its Machine.identifier,
# because docker/mosquitto/acl pins it to {MQTT_PREFIX}/machines/%u/...
MQTT_USERNAME=backend
MQTT_PASSWORD=CHANGE_ME_broker_password_created_by_bin_mqtt-user
# Used as a PREFIX only: every connection appends a random suffix, because MQTT
# allows just one live connection per client id (publisher vs consumer).
MQTT_CLIENT_ID=3awedlou-backend
# TLS is NOT used in dev (plaintext 127.0.0.1:1883, loopback only).
# Any deployment MUST use TLS on 8883 with per-device credentials.
MQTT_TLS=false
# Topic prefix — must also match docker/mosquitto/acl.
MQTT_PREFIX=3awedlou
# QoS for outbound commands and inbound subscriptions (0|1|2).
MQTT_QOS=1
# A command expires this many seconds after issue (payload field "expiresAt").
MQTT_COMMAND_TTL_SECONDS=30
# The consumer drops inbound payloads larger than this many bytes.
MQTT_MAX_PAYLOAD_BYTES=4096
# The consumer accepts at most this many telemetry messages per machine/second.
MQTT_TELEMETRY_MAX_PER_SECOND=2

# --- Mail (dev: log to stderr; use smtp:// for real delivery) ---------------
MAILER_DSN=null://null

# --- Messenger (not used for machine I/O yet; kept for future async work) ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
