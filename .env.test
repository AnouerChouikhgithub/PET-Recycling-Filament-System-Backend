# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Test database: the db_3awedlou_test schema on the SAME dev Postgres
# (127.0.0.1:5432), so tests can never touch dev data. NOTE: point this at
# the BASE name (db_3awedlou) ??? doctrine.yaml's when@test `dbname_suffix:
# _test` appends the suffix, resolving to db_3awedlou_test. Writing the
# suffixed name here would double it (db_3awedlou_test_test).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/db_3awedlou?serverVersion=17&charset=utf8"

AUTH_REGISTER_ENABLED=true
COMMAND_HEATER_MAX_C=260
COMMAND_MOTOR_MAX=100
COMMAND_FAN_MAX=100

# Rate limits in test: relaxed so the suite does not trip them (phpunit.dist.xml
# pins the same values). AuthRateLimitFunctionalTest overrides these to the
# strict production numbers to exercise the real 429 path.
RATE_LIMIT_LOGIN=1000
RATE_LIMIT_REGISTER=1000
JWT_PASSPHRASE=308e444b639998f62777f58d92c6faf9f00aa21a94afe16275b0af5524d69477

# --- AI agent (test defaults; strict values are pinned per-test) -----------
AGENT_ENABLED=true
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
AGENT_MAX_TOKENS=1024
AGENT_MAX_TOOL_ROUNDS=4
AGENT_CONTEXT_MESSAGES=12
AGENT_RATE_LIMIT_MESSAGES=20
AGENT_RATE_LIMIT_INTERVAL_SEC=300
AGENT_DAILY_TOKEN_CAP=100000000
AGENT_MSG_MAX_CHARS=4000
AGENT_BASE_URL=
AGENT_CONNECT_TIMEOUT_SEC=5
AGENT_REQUEST_TIMEOUT_SEC=30
