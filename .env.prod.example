# =============================================================================
# 3awedlou backend — PRODUCTION template. PREPARED, NEVER RUN.
#
#   cp .env.prod.example .env.prod
#   # fill every CHANGE_ME value, then:
#   docker compose -f compose.prod.yaml up -d
#
# .env.prod is git-ignored and must never be committed. Every value here is a
# placeholder; none of them is a working credential.
# =============================================================================

# --- Symfony core -----------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
# openssl rand -base64 32
APP_SECRET=CHANGE_ME_32_random_bytes_base64
APP_SHARE_DIR=var/share

# --- Public entrypoint (Caddy) ---------------------------------------------
# Domain that resolves to the VPS; Caddy obtains the certificate for it.
APP_DOMAIN=CHANGE_ME_app.example.com
# Contact address for Let's Encrypt expiry notices.
ACME_EMAIL=CHANGE_ME_ops@example.com

# --- Proxy trust ------------------------------------------------------------
# Caddy runs inside the app container and php-fpm sees the real client address,
# so no proxy is trusted by default. Only fill this in when another reverse
# proxy sits in front of Caddy.
TRUSTED_PROXIES=
TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-host,x-forwarded-port
DEFAULT_URI=https://CHANGE_ME_app.example.com

# --- Database (compose service `postgres`, never published) -----------------
# Host is the compose service name; the password MUST match POSTGRES_PASSWORD.
POSTGRES_DB=db_3awedlou
POSTGRES_USER=3awedlou
POSTGRES_PASSWORD=CHANGE_ME_database_password
DATABASE_URL="postgresql://3awedlou:CHANGE_ME_database_password@postgres:5432/db_3awedlou?serverVersion=17&charset=utf8"

# --- JWT (RS256) ------------------------------------------------------------
# Generate the pair on the host and mount it read-only at config/jwt/prod:
#   php bin/console lexik:jwt:generate-keypair --env=prod
# Key files are git-ignored and never part of the image.
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME_jwt_key_passphrase

# --- CORS -------------------------------------------------------------------
# Pin to the real web origin. Never use the permissive dev regex in production.
CORS_ALLOW_ORIGIN=^https://CHANGE_ME_app\.example\.com$

# --- Auth policy ------------------------------------------------------------
AUTH_REGISTER_ENABLED=true

# --- Machine domain ---------------------------------------------------------
MACHINE_OFFLINE_AFTER_MINUTES=10
COMMAND_HEATER_MAX_C=260
COMMAND_MOTOR_MAX=100
COMMAND_FAN_MAX=100

# --- MQTT (TLS only; broker is the compose service `mosquitto`) -------------
MQTT_ENABLED=true
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_USERNAME=backend
MQTT_PASSWORD=CHANGE_ME_broker_password_created_on_the_host
MQTT_CLIENT_ID=3awedlou-backend
MQTT_TLS=true
MQTT_PREFIX=3awedlou
MQTT_QOS=1
MQTT_COMMAND_TTL_SECONDS=30
MQTT_MAX_PAYLOAD_BYTES=4096
MQTT_TELEMETRY_MAX_PER_SECOND=2
MQTT_CONSUMER_MAX_MESSAGES=10000

# --- Mail -------------------------------------------------------------------
# Real delivery is required in production; the dev null transport silently
# discards password-reset mail.
MAILER_DSN=smtp://CHANGE_ME_user:CHANGE_ME_password@CHANGE_ME_smtp_host:587

# --- Messenger --------------------------------------------------------------
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# --- AI agent ---------------------------------------------------------------
# The key lives only in this file/process environment; never in git or an image.
AGENT_ENABLED=false
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-4-5
AGENT_BASE_URL=
AGENT_CONNECT_TIMEOUT_SEC=5
AGENT_REQUEST_TIMEOUT_SEC=30
AGENT_TURN_DEADLINE_SEC=45
AGENT_RETENTION_DAYS=30
AGENT_SOFT_DELETE_GRACE_DAYS=7
AGENT_MAX_TOKENS=1024
AGENT_MAX_TOOL_ROUNDS=4
AGENT_CONTEXT_MESSAGES=12
AGENT_RATE_LIMIT_MESSAGES=20
AGENT_RATE_LIMIT_INTERVAL_SEC=300
# Per user per UTC day; the whole turn is reserved up front.
AGENT_DAILY_TOKEN_CAP=200000
AGENT_MSG_MAX_CHARS=4000
