# =============================================================================
# 3awedlou backend ??? copy to .env.local (NEVER commit .env.local) and fill in.
#   cp .env.example .env.local
# Values below are PLACEHOLDERS. Real secrets live only in .env.local or the
# process environment ??? never in git.
# =============================================================================

# --- Symfony core -----------------------------------------------------------
# dev | prod | test
APP_ENV=dev
# `php bin/console secret:generate` or: openssl rand -base64 32
APP_SECRET=
APP_SHARE_DIR=var/share
DEFAULT_URI=http://localhost

# --- Database (PostgreSQL 17 via `docker compose up -d`) --------------------
# serverVersion must match your server; charset utf8.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/db_3awedlou?serverVersion=17&charset=utf8"

# --- JWT (RS256) ------------------------------------------------------------
# Generate once with:  php bin/console lexik:jwt:generate-keypair
# (writes config/jwt/private.pem + public.pem ??? git-ignored)
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
# Passphrase you chose when generating the keypair (may be empty in dev)
JWT_PASSPHRASE=

# --- CORS -------------------------------------------------------------------
# Regex of allowed browser origins. Dev default covers Vite (5173) + Expo web.
# PRODUCTION: pin to your real origin, e.g. ^https://app\.3awedlou\.example$
CORS_ALLOW_ORIGIN=^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$

# --- Auth policy ------------------------------------------------------------
# Set to false to close open registration (login keeps working).
AUTH_REGISTER_ENABLED=true

# --- Machine domain ---------------------------------------------------------
# A machine is OFFLINE when its last report is older than this many minutes.
MACHINE_OFFLINE_AFTER_MINUTES=10

# Command safety limits (backend-side guard; firmware PET PID target is 245 ??C,
# so the heater cap must stay above 245 but far below danger).
COMMAND_HEATER_MAX_C=260
COMMAND_MOTOR_MAX=100
COMMAND_FAN_MAX=100

# --- MQTT (PREPARED ??? the transport client is not wired yet) ----------------
# Broker credentials live ONLY here / in .env.local. The default publisher
# buffers + logs; wiring a real broker is one alias swap in services.yaml.
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=3awedlou-backend
MQTT_TLS=false
MQTT_PREFIX=3awedlou

# --- Mail (dev: log to stderr; use smtp:// for real delivery) ---------------
MAILER_DSN=null://null

# --- Messenger (not used for machine I/O yet; kept for future async work) ---
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
